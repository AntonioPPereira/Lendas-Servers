# Lendas panel — runtime wiring.
# Leave everything unset to run the panel against generated data.

# REST base for ranking, demos, matches, bans and stats.
# Local dev, apontando pro backend em server/: http://localhost:8787/api
# Produção: https://api.lendas.gg/v1 (ou onde o backend acabar hospedado)
#
# Demos não têm modo mock — sem isso configurado, a página de Demos mostra
# um erro claro em vez de fingir uma listagem (ver server/DATA-SOURCES.md).
VITE_API_URL=

# Push endpoint for the live match and the activity feed.
# WebSocket: wss://api.lendas.gg/live
# SSE:       https://api.lendas.gg/live/stream
VITE_LIVE_URL=

# mock | websocket | sse
# Independente de VITE_API_URL — dá pra ter demos reais com o placar ao vivo
# ainda em mock, ou vice-versa.
VITE_LIVE_TRANSPORT=mock
