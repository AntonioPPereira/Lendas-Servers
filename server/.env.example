# LENDAS backend — configuração de runtime.
# Copie para .env e preencha. Nunca commite o .env com valores reais.

# Porta HTTP do backend.
PORT=8787

# Origem permitida para CORS (o painel React). Em produção, aponte para o
# domínio real do painel — nunca use "*" quando há downloads autenticáveis.
CORS_ORIGIN=http://localhost:5173

# --- SFTP: filesystem de demos do servidor CS:S ---------------------------
# Host confirmado do servidor de demos (ClanServers).
SFTP_HOST=104.234.65.248
SFTP_PORT=8822
# Preencha com as credenciais reais — nunca commitar.
SFTP_USERNAME=
SFTP_PASSWORD=

# Pasta que contém uma subpasta por servidor de jogo, nomeada "IP_PORTA"
# (ex: "104.234.65.244_27800"). O backend descobre os servidores sozinho
# listando isto — não precisa cadastrar cada um à mão. "/" cobre a raiz
# inteira da conta SFTP; estreite só se a conta tiver outras coisas soltas
# na raiz que não sejam pastas de servidor.
SFTP_BASE=/

# Por quantos ms a listagem de demos fica em cache antes de reconsultar o
# SFTP. Evita abrir uma conexão nova a cada requisição do frontend.
DEMOS_CACHE_TTL_MS=60000

# --- HLstatsX: servidores, ranking, jogadores ------------------------------
# Sem API estruturada (confirmado na auditoria) — o backend faz parsing do
# HTML público, isolado em src/lib/hlstatsParse.ts.
HLSTATS_BASE_URL=https://mixlendas-rank.clanservers.com.br/hlstats.php
HLSTATS_GAME=css
# Timeout de cada requisição HTTP ao HLstatsX.
HLSTATS_TIMEOUT_MS=10000
# Status/mapa/jogadores por servidor: cache curto, muda a cada partida.
SERVERS_CACHE_TTL_MS=10000
# Ranking: cache mais longo, a tabela inteira (~6 páginas) é buscada de novo
# a cada expiração.
RANKING_CACHE_TTL_MS=45000

# --- lendas_steamfilter: estado real do filtro de requisitos --------------
# O plugin (rodando nos dois servidores CS:S) já grava cada veredito
# (aprovado / bloqueado) nos logs diários do SourceMod, sem precisar de
# nenhuma configuração extra — lido pela MESMA conexão SFTP configurada
# acima pras demos. Não existe credencial própria nem banco de dados aqui.
# Veja server/README.md.
# Feed de atividade (join/blocked) muda a cada conexão real — cache curto.
ACTIVITY_CACHE_TTL_MS=10000
# Quantos eventos recentes o feed traz por vez.
ACTIVITY_LIMIT=60

# --- lendas_live: placar, round e jogadores ao vivo ------------------------
# Novo plugin SourceMod (separado do lendas_steamfilter, não mexe nele) que
# manda POST /api/live/events com o estado real da partida. Veja
# server/README.md pro contrato completo e o guia de instalação do plugin.
#
# Token compartilhado entre o plugin e este backend. Vazio (padrão) = a rota
# de ingestão sempre responde 503 "não configurado" — nunca aceita eventos
# sem autenticação. GERE UM VALOR ALEATÓRIO FORTE, não deixe vazio nem use
# um valor óbvio — quem tiver esse token pode forjar o placar do site.
LIVE_API_TOKEN=
# Servidor sem snapshot novo há mais que isso é considerado morto (server
# caiu, plugin travou) e some do estado ao vivo.
LIVE_STALE_MS=30000
# Intervalo do keep-alive de cada conexão SSE aberta pelo frontend.
LIVE_SSE_HEARTBEAT_MS=15000

# --- Avatares reais via Steam Web API ---------------------------------------
# SÓ o backend consulta a Steam — o plugin manda apenas o SteamID64 real
# capturado, nunca a key. Vazio (padrão) = avatar real desligado, o frontend
# cai pro emblema gerado (comportamento já existente, sem quebrar nada).
# Pode ser a mesma key já usada em cfg/lsf_apikey.cfg do lendas_steamfilter,
# ou uma nova — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Avatar muda raro — cache bem mais longo que qualquer outra fonte aqui.
STEAM_AVATAR_CACHE_TTL_MS=3600000
